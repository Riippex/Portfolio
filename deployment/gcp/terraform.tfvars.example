# Google Cloud configuration example
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars containing real credentials.
# No secret value belongs in this file or anywhere in Terraform: secret payloads are
# added to Secret Manager out of band (see docs/runbooks/infrastructure.md).

project_id                         = "my-gcp-project-id"
region                             = "us-central1"
environment                        = "dev" # stage name only; the ASP.NET environment is always Production
service_name                       = "rafael-portfolio-backend"
backend_service_account_id         = "sa-portfolio-backend"
artifact_repository_id             = "portfolio"
backend_port                       = 8080
min_instances                      = 0
max_instances                      = 2
cpu_limit                          = "1000m"
memory_limit                       = "512Mi"
allow_unauthenticated              = true
github_repository                  = "Riippex/Portfolio"
workload_identity_pool_id          = "github-actions-pool"
workload_identity_pool_provider_id = "github-provider"
ci_service_account_id              = "sa-portfolio-ci"

# Bootstrap stage 1 (default): APIs, registry, identities, federation, empty secret containers.
create_service = false

# Bootstrap stage 3, after the secret versions exist and an image has been pushed: replace the
# line above with these two and KEEP them in this ignored file. The same file must be passed to
# every later plan and apply (terraform plan -var-file=<stage>.tfvars). Do not supply them as
# one-off -var overrides: a plan made without them targets the foundation phase and, with the
# service established, is refused by prevent_destroy rather than removing it.
# create_service  = true
# container_image = "us-central1-docker.pkg.dev/my-gcp-project-id/portfolio/backend:<immutable-tag>"

# Shared model control database (owned by deployment/control-ledger, never by a stage). Leave
# empty until the owner has applied that stack; every stage must then name the SAME project and
# database so dev and prod share one allowance.
control_ledger_project_id  = ""
control_ledger_database_id = ""
