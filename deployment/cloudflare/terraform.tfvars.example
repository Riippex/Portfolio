# Cloudflare configuration example
# Copy this file to terraform.tfvars and fill in real values.
# NEVER commit terraform.tfvars containing real credentials.
# This stack holds no secret payloads: the Worker secret and the Turnstile widget are
# managed outside Terraform (see docs/runbooks/infrastructure.md).
#
# There is no credential input. Authenticate by exporting CLOUDFLARE_API_TOKEN in your shell
# for the session; never put a token in this file (saved plans record variable values).

zone_id              = "placeholder-zone-id"
domain_name          = "rafaelpatinodiaz.com"
environment          = "dev" # dev -> rafael-portfolio-frontend-dev at dev.<domain>; prod -> ...-prod at the apex
worker_name_prefix   = "rafael-portfolio-frontend"
enable_custom_domain = false
