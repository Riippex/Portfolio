    "@types/react-dom": "^19",
    "@vinext/cloudflare": "^1.0.0-beta.9",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vinext": "^1.0.0-beta.11"
  },
  "type": "module"
